{
  "name": "mitroff-intro",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts MitroffIntro out/mitroff-intro-v3-preview.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=320k --pixel-format=yuv420p",
    "still": "remotion still src/index.ts MitroffIntro out/preview-v3.png --frame=540",
    "render:silent": "remotion render src/index.ts MitroffIntro out/mitroff-intro-v3-silent.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=320k --pixel-format=yuv420p --muted"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "remotion": "4.0.535",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
